planeStress     no;

mechanical      1 ( copper { type linearElasticMisesPlastic ; rho rho [ 1 -3 0 0 0 0 0 ] 8960 ; E E [ 1 -1 -2 0 0 0 0 ] 1.1e+11 ; nu nu [ 0 0 0 0 0 0 0 ] 0.34 ; "file|fileName" "$FOAM_CASE/constant/solid/plasticStrainVsYieldStress" ; outOfBounds clamp ; solvePressureEqn no ; pressureSmoothingScaleFactor 100 ; } ; );


