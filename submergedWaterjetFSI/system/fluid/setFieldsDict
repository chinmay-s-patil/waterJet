FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volVectorFieldValue U (0 0 0)
);

regions
(
    // Square nozzle jet column matching the 2x2 mm inlet patch geometry
    // extending from z = 6.001 mm down to 0.2 mm above the copper plate
    boxToCell
    {
        box (-0.001001 -0.001001 0.0002) (0.001001 0.001001 0.006001);
        fieldValues
        (
            volVectorFieldValue U (0 0 -30)
        );
    }
);

