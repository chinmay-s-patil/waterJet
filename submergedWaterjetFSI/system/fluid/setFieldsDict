FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volVectorFieldValue U (0 0 0)
);

regions
(
    // Cylindrical initialised nozzle region connected directly to inlet boundary
    cylinderToCell
    {
        point1  (0 0 0.006001); // Top inlet boundary (connected)
        point2  (0 0 0.003);    // Initial jet development zone
        radius  0.001;          // Nozzle radius 1 mm
        fieldValues
        (
            volVectorFieldValue U (0 0 -30)
        );
    }
);

