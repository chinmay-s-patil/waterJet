/*--------------------------------*- C++ -*----------------------------------*\
| solids4foam: solid mechanics and fluid-solid interaction simulations        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         4e-06; // 100 microseconds

deltaT          2e-06;  // 2 microseconds (Co < 0.5)

writeControl    timeStep;

writeInterval   1;      // write every 10 microseconds (10 time directories total)

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

functions
{
    centerPlateDisplacement
    {
        type    solidPointDisplacement;
        point   (0 0 0); // center of copper plate interface
    }
}

// ************************************************************************* //
